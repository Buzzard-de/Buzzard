# Buzzard environment variable template
# Put real secrets only in deployment secret manager or local untracked .env.

# Sales / pricing (set to 1 when online shop should accept orders and show prices)
NEXT_PUBLIC_SALES_ENABLED=0

# Public storefront API base URL (safe to expose in frontend static export)
NEXT_PUBLIC_BUZZARD_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://buzzard24.de

# Full-stack SQLite store (Buzzard FullStack v0.4)
# When enabled, account/cart/orders/admin use JWT + SQLite REST API
NEXT_PUBLIC_SQLITE_STORE=0

# GitHub Actions: set repository variable BUZZARD_API_URL or secret to your deployed API
# Default production target in deploy workflow: https://buzzard-api.onrender.com

# AI / automation (frontend feature flags)
NEXT_PUBLIC_AI_CHAT_ENABLED=1

# Marketing / measurement (configure in deployment; never commit real production IDs)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_MERCHANT_CENTER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-side secrets (never commit real values)
DATABASE_URL=
AUTH_SECRET=
JWT_SECRET=
SESSION_SECRET=

# SQLite backend (Buzzard Backend Database v0.3)
BUZZARD_DB_ENABLED=1
BUZZARD_COMMERCIAL_INTEGRATIONS=1
ADMIN_EMAIL=admin@buzzard.de
ADMIN_PASSWORD=

# Commercial integrations (Buzzard v0.5) — server-side only
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
KLARNA_USERNAME=
KLARNA_PASSWORD=
DHL_API_KEY=
DPD_API_KEY=
GLS_API_KEY=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
FX_PROVIDER_URL=
TAX_PROVIDER_URL=
TAX_PROVIDER_API_KEY=
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
TECDOC_API_URL=
TECDOC_API_KEY=

PAYMENT_PROVIDER_SECRET=
SUPPLIER_API_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# AI provider (server-side only; optional LLM integration point)
AI_PROVIDER=rules
OPENAI_API_KEY=
AI_MODEL=

# Automation
BUZZARD_AI_CHAT_ENABLED=1
BUZZARD_ABANDONED_CART_DELAY_HOURS=24

# Observability integration point (optional)
ERROR_TRACKING_DSN=

# Optional server hardening
# NODE_ENV=production
# BUZZARD_HSTS=1
# PORT=3001
