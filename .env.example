# Buzzard environment variable template
# Put real secrets only in deployment secret manager or local untracked .env.

# Sales / pricing (set to 1 when online shop should accept orders and show prices)
NEXT_PUBLIC_SALES_ENABLED=0
# Server-side mirror for AI chat and order flows (keep in sync with NEXT_PUBLIC_SALES_ENABLED)
BUZZARD_SALES_ENABLED=0

# Public storefront API base URL (safe to expose in frontend static export)
NEXT_PUBLIC_BUZZARD_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://buzzard24.de

# Full-stack SQLite store (Buzzard FullStack v0.4)
# When enabled, account/cart/orders/admin use JWT + SQLite REST API
NEXT_PUBLIC_SQLITE_STORE=0

# Live catalog & vehicle data from Buzzard API (v0.7/v0.8)
NEXT_PUBLIC_CATALOG_SEO=1
NEXT_PUBLIC_VEHICLE_API=1
NEXT_PUBLIC_LOCALIZATION_FEEDS=1
NEXT_PUBLIC_CUSTOMER_CHECKOUT=1
NEXT_PUBLIC_CUSTOMER_SUPPORT=1
NEXT_PUBLIC_CRM_LOYALTY=1
NEXT_PUBLIC_ANALYTICS_DASHBOARD=1
NEXT_PUBLIC_MARKETING_CENTER=1
NEXT_PUBLIC_MARKETPLACE_HUB=1
NEXT_PUBLIC_LOGISTICS_FULFILLMENT=1
NEXT_PUBLIC_WMS_INVENTORY=1
NEXT_PUBLIC_PIM_CATALOG=1
NEXT_PUBLIC_IDENTITY_SECURITY=1
NEXT_PUBLIC_PAYMENTS_FINANCE=1
NEXT_PUBLIC_ORDER_MANAGEMENT=1
NEXT_PUBLIC_CART_CHECKOUT=1
NEXT_PUBLIC_CRM_CUSTOMER_SERVICE=1
NEXT_PUBLIC_RETURNS_RMA=1
NEXT_PUBLIC_MARKETING_LOYALTY=1
NEXT_PUBLIC_REVIEWS_RATINGS=1
NEXT_PUBLIC_AI_CENTER=1
NEXT_PUBLIC_ADVANCED_SEARCH=1
NEXT_PUBLIC_PRODUCT_CATALOG_PIM=1
NEXT_PUBLIC_SUPPLIER_INTEGRATION_HUB=1
NEXT_PUBLIC_ORDER_MANAGEMENT_V32=1
NEXT_PUBLIC_FULFILLMENT_V33=1
NEXT_PUBLIC_LOGISTICS_V34=1
NEXT_PUBLIC_MARKETPLACE_V35=1
NEXT_PUBLIC_PAYMENTS_V36=1
NEXT_PUBLIC_INTERNATIONAL_V37=1
NEXT_PUBLIC_SECURITY_V38=1
NEXT_PUBLIC_ANALYTICS_V39=1
NEXT_PUBLIC_MASTER_ADMIN_V40=1

# GitHub Actions: set repository variable BUZZARD_API_URL or secret to your deployed API
# Default production target in deploy workflow: https://buzzard-api.onrender.com

# AI / automation (frontend feature flags)
NEXT_PUBLIC_AI_CHAT_ENABLED=1

# Marketing / measurement (configure in deployment; never commit real production IDs)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_MERCHANT_CENTER_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-side secrets (never commit real values)
DATABASE_URL=
AUTH_SECRET=
JWT_SECRET=
SESSION_SECRET=

# SQLite backend (Buzzard Backend Database v0.3)
BUZZARD_DB_ENABLED=1
# Optional: persistent path on Render disk mount (see docs/RENDER_API_GO_LIVE.md)
# BUZZARD_DB_PATH=/var/data/buzzard.db
# Optional: extra CORS origins (comma-separated)
# BUZZARD_CORS_ORIGINS=
BUZZARD_COMMERCIAL_INTEGRATIONS=1
BUZZARD_ORDER_AUTOMATION=1
BUZZARD_SUPPLIER_HUB=1
BUZZARD_CATALOG_SEO=1
BUZZARD_LOCALIZATION_FEEDS=1
BUZZARD_CUSTOMER_CHECKOUT=1
BUZZARD_CUSTOMER_SUPPORT=1
BUZZARD_CRM_LOYALTY=1
BUZZARD_ANALYTICS_DASHBOARD=1
BUZZARD_MARKETING_CENTER=1
BUZZARD_MARKETPLACE_HUB=1
BUZZARD_LOGISTICS_FULFILLMENT=1
BUZZARD_WMS_INVENTORY=1
BUZZARD_PIM_CATALOG=1
BUZZARD_IDENTITY_SECURITY=1
BUZZARD_PAYMENTS_FINANCE=1
BUZZARD_ORDER_MANAGEMENT=1
BUZZARD_CART_CHECKOUT=1
BUZZARD_CRM_CUSTOMER_SERVICE=1
BUZZARD_RETURNS_RMA=1
BUZZARD_MARKETING_LOYALTY=1
BUZZARD_REVIEWS_RATINGS=1
BUZZARD_AI_CENTER=1
BUZZARD_ADVANCED_SEARCH=1
BUZZARD_PRODUCT_CATALOG_PIM=1
BUZZARD_SUPPLIER_INTEGRATION_HUB=1
BUZZARD_ORDER_MANAGEMENT_V32=1
BUZZARD_FULFILLMENT_V33=1
BUZZARD_LOGISTICS_V34=1
BUZZARD_MARKETPLACE_V35=1
BUZZARD_PAYMENTS_V36=1
BUZZARD_INTERNATIONAL_V37=1
BUZZARD_SECURITY_V38=1
BUZZARD_ANALYTICS_V39=1
BUZZARD_MASTER_ADMIN_V40=1
DEFAULT_PAYMENT_PROVIDER=stripe
DEFAULT_CARRIER=dhl
DEFAULT_SUPPLIER_MODE=manual
ADMIN_EMAIL=admin@buzzard.de
ADMIN_PASSWORD=

# Commercial integrations (Buzzard v0.5) — server-side only
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
KLARNA_USERNAME=
KLARNA_PASSWORD=
DHL_API_KEY=
DPD_API_KEY=
GLS_API_KEY=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
FX_PROVIDER_URL=
TAX_PROVIDER_URL=
TAX_PROVIDER_API_KEY=
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
TECDOC_API_URL=
TECDOC_API_KEY=
SUPPLIER_SYNC_CRON=

# Catalog & SEO (Buzzard v0.8)
PUBLIC_BASE_URL=https://buzzard24.de
DEFAULT_MARGIN=0.30
MIN_MARGIN=0.12

PAYMENT_PROVIDER_SECRET=
SUPPLIER_API_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# AI provider (server-side only; optional LLM integration point)
AI_PROVIDER=rules
OPENAI_API_KEY=
AI_MODEL=

# Automation
BUZZARD_AI_CHAT_ENABLED=1
BUZZARD_ABANDONED_CART_DELAY_HOURS=24

# Observability integration point (optional)
ERROR_TRACKING_DSN=

# Optional server hardening
# NODE_ENV=production
# BUZZARD_HSTS=1
# PORT=3001
