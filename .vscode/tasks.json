{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Buzzard: Dev (Frontend + API)",
      "type": "npm",
      "script": "dev:all",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Buzzard: Build",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      "label": "Buzzard: Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Buzzard: Typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"]
    }
  ]
}
