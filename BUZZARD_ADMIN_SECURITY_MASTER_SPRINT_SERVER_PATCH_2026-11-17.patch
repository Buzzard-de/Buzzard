diff --git a/server/lib/jsonFileStore.js b/server/lib/jsonFileStore.js
new file mode 100644
index 0000000..057fc83
--- /dev/null
+++ b/server/lib/jsonFileStore.js
@@ -0,0 +1,85 @@
+/**
+ * JSON file persistence for the admin security stores.
+ *
+ * Writes go to a temporary file in the same directory and are renamed over the
+ * target, so a reader or a crash never sees a half-written file. A file that
+ * exists but cannot be parsed is copied aside before the caller falls back to
+ * an empty value: the next write would otherwise replace the history with only
+ * the newest entry.
+ *
+ * This does not serialise writers in different processes. Two API processes
+ * appending to the same log can still lose one of two simultaneous entries.
+ */
+const crypto = require("crypto");
+const fs = require("fs");
+const path = require("path");
+
+const PRIVATE_FILE_MODE = 0o600;
+const reportedCorrupt = new Set();
+
+function preserveCorruptFile(file, raw) {
+  const digest = crypto.createHash("sha256").update(raw).digest("hex").slice(0, 12);
+  const copy = `${file}.corrupt-${digest}`;
+  try {
+    if (!fs.existsSync(copy)) {
+      fs.writeFileSync(copy, raw, { mode: PRIVATE_FILE_MODE, flag: "wx" });
+    }
+  } catch {
+    return null;
+  }
+  if (!reportedCorrupt.has(copy)) {
+    reportedCorrupt.add(copy);
+    console.error(`[json-store] ${path.basename(file)} is not valid JSON; original kept as ${path.basename(copy)}`);
+  }
+  return copy;
+}
+
+function readJsonFile(file, fallback, { validate } = {}) {
+  let raw;
+  try {
+    raw = fs.readFileSync(file, "utf8");
+  } catch {
+    return fallback;
+  }
+  if (!raw.trim()) return fallback;
+  let parsed;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    preserveCorruptFile(file, raw);
+    return fallback;
+  }
+  if (validate && !validate(parsed)) {
+    preserveCorruptFile(file, raw);
+    return fallback;
+  }
+  return parsed;
+}
+
+function readJsonArray(file) {
+  return readJsonFile(file, [], { validate: Array.isArray });
+}
+
+function writeJsonAtomic(file, data, { durable = false } = {}) {
+  const dir = path.dirname(file);
+  fs.mkdirSync(dir, { recursive: true });
+  const tmp = path.join(dir, `.${path.basename(file)}.${process.pid}.${crypto.randomBytes(6).toString("hex")}.tmp`);
+  const fd = fs.openSync(tmp, "wx", PRIVATE_FILE_MODE);
+  try {
+    fs.writeFileSync(fd, JSON.stringify(data, null, 2), "utf8");
+    if (durable) fs.fsyncSync(fd);
+  } catch (err) {
+    fs.closeSync(fd);
+    fs.rmSync(tmp, { force: true });
+    throw err;
+  }
+  fs.closeSync(fd);
+  try {
+    fs.renameSync(tmp, file);
+  } catch (err) {
+    fs.rmSync(tmp, { force: true });
+    throw err;
+  }
+}
+
+module.exports = { readJsonFile, readJsonArray, writeJsonAtomic, preserveCorruptFile, PRIVATE_FILE_MODE };
