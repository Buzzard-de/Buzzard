+ * Sign-in data of the synthetic account for a role, from the file that
+ * scripts/isolated/api.sh names in BUZZARD_SYNTHETIC_ADMINS. Scripts carry no
+ * account names or passwords of their own.
+ */
+export function syntheticAccount(role, { env = process.env } = {}) {
+  const file = env.BUZZARD_SYNTHETIC_ADMINS;
+  if (!file) {
+    throw new Error("BUZZARD_SYNTHETIC_ADMINS is not set (scripts/isolated/api.sh provides it)");
+  }
