+function responseRecorder() {
+  return {
+    statusCode: null,
+    body: null,
+    writeHead(status) {
+      this.statusCode = status;
+    },
+    setHeader() {},
+    end(payload) {
+      this.body = payload ? JSON.parse(payload) : null;
+    },
+    status(code) {
+      this.statusCode = code;
+      return this;
+    },
+    json(payload) {
+      this.body = payload;
+      return this;
