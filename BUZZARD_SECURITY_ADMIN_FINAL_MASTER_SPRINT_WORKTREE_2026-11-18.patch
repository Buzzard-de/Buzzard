+  it("on a hosted runtime that forgot NODE_ENV=production", async () => {
+    await expectRefusal({ NODE_ENV: "development", RENDER: "true", JWT_SECRET: undefined }, /JWT_SECRET must be set/);
+  }, 60_000);
