+#!/usr/bin/env node
+/**
+ * Copies the JSON stores (accounts, sessions, logs, and the customer, order
+ * and other data files next to them) from one directory to another, e.g. from
+ * server/data to the persistent disk. The SQLite database is not part of it.
+ *
+ *   node scripts/migrate-json-stores.mjs --from <dir> --to <dir>            # report only
+ *   node scripts/migrate-json-stores.mjs --from <dir> --to <dir> --apply    # copy
+ *
+ * - Without --apply nothing is written.
+ * - The source is only read. Nothing in it is changed or removed, which is
+ *   also the way back: point BUZZARD_DATA_DIR at the source again.
+ * - A file that already exists at the target is never overwritten; the run
+ *   stops before copying anything.
+ * - Every copy is compared with its source by SHA-256. Files get mode 600,
+ *   the target directory 700.
+ * - The server must not be running on either directory while this copies.
+ *
+ * Prints file names, sizes and hashes of the files, never their content.
+ */
+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+
+function fail(message) {
+  console.error(`migrate-json-stores: ${message}`);
+  process.exit(1);
+}
+
+function argument(name) {
+  const index = process.argv.indexOf(name);
+  return index >= 0 ? process.argv[index + 1] : null;
+}
+
+const from = argument("--from");
+const to = argument("--to");
+const apply = process.argv.includes("--apply");
+if (!from || !to) fail("usage: --from <dir> --to <dir> [--apply]");
+
+const source = path.resolve(from);
+const target = path.resolve(to);
+if (source === target) fail("source and target are the same directory");
+if (target.startsWith(source + path.sep) || source.startsWith(target + path.sep)) fail("one directory lies inside the other");
+if (!fs.existsSync(source) || !fs.statSync(source).isDirectory()) fail("source directory does not exist");
+
+const sha256 = (file) => createHash("sha256").update(fs.readFileSync(file)).digest("hex");
+
+/**
+ * BUZZARD_DATA_DIR moves every JSON store the server keeps, not only the
+ * administrator files: customers, orders, submissions and the rest would be
+ * looked for at the new place as well. So everything that is a data file is
+ * copied, and whatever is left behind is listed with the reason.
+ */
+function reasonToSkip(name, stat) {
+  if (stat.isDirectory()) return "directory (copy separately if it holds data)";
+  if (!stat.isFile()) return "not a regular file";
+  if (/\.(db|sqlite|sqlite3)(-wal|-shm|-journal)?$/.test(name)) return "database (located by BUZZARD_DB_PATH, back it up with the database tools)";
+  if (name.endsWith(".lock") || /\.lock\.\d+\./.test(name)) return "lock file";
+  if (/^\..*\.tmp$/.test(name)) return "unfinished temporary file";
+  if (name === "build-info.json") return "build artefact, read from the installation directory";
+  if (name === ".gitkeep" || name === ".gitignore") return "repository file";
+  if (/^migration-.*\.manifest\.json$/.test(name)) return "manifest of an earlier migration";
+  return null;
+}
+
+const entries = fs.readdirSync(source).sort().map((name) => ({ name, stat: fs.statSync(path.join(source, name)) }));
