+const LANGUAGE = /^[a-z]{2,3}(-[A-Za-z]{2,4})?$/;
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const TOKEN = /^[A-Za-z][A-Za-z0-9_-]{0,39}$/;
