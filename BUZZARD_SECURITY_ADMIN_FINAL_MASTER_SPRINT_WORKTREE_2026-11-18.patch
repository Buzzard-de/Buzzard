+  const parsed = path.parse(file);
+  const prefix = `${parsed.name}.archive`;
+  try {
+    return fs
+      .readdirSync(parsed.dir)
+      .filter((name) => name.startsWith(prefix) && name.endsWith(".jsonl"))
+      .sort()
+      .map((name) => path.join(parsed.dir, name));
+  } catch {
