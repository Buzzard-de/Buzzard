+/** Ends the process (status 78) before anything is written, unless the API reports throwaway storage. */
+export async function requireIsolatedApi(api, options = {}) {
+  const problems = await isolationProblems(api, options);
+  if (problems.length === 0) return;
+  console.error(
+    [
+      `This script sends write requests and will not run against ${api}:`,
+      ...problems.map((problem) => `  - ${problem}`),
+      "Run it against an isolated API instead:",
+      `  scripts/isolated/api.sh -- node ${path.relative(process.cwd(), process.argv[1] || "<script>")}`,
+    ].join("\n")
+  );
