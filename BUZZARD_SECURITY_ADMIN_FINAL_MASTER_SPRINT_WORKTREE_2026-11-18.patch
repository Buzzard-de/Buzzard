+  DEFAULT_KEEP,
+  appendRecord,
+  appendToArchive,
+  readRecords,
+  readArchive,
+  archiveFileOf,
+  archiveFilesOf,
+  verifyChain,
+  verifyRecordFile,
+  hashEntry,
+};
