+/** Reasons why the API at `api` is not a throwaway one; empty when it is. Sends one GET and nothing else. */
+export async function isolationProblems(api, { fetchImpl = fetch } = {}) {
+  let health;
+  try {
+    const response = await fetchImpl(`${api}/api/health`, { headers: { Accept: "application/json" } });
+    health = await response.json();
+  } catch {
+    return ["it did not answer the health check with a report, so its storage cannot be checked"];
+  }
+  if (!health || typeof health !== "object") {
+    return ["it did not answer the health check with a report, so its storage cannot be checked"];
+  }
+  const problems = [];
+  const tmp = fs.realpathSync(os.tmpdir()) + path.sep;
+  const dbPath = typeof health.database?.path === "string" && health.database.path ? path.resolve(health.database.path) : "";
