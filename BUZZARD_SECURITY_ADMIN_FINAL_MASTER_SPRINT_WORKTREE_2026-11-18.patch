+
+describe("JSON-LD written into a script element", () => {
+  const hostile = {
+    "@type": "Product",
+    name: 'Bremsscheibe </script><script>window.x=sessionStorage.getItem("buzzard_admin_token")</script>',
+    description: "<!-- <script> & \u2028 \u2029 ]]>",
+  };
