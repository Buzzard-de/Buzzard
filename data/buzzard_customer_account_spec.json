{
  "package": "06",
  "name": "Buzzard Customer Account",
  "features": [
    "registration",
    "login",
    "logout",
    "password_reset",
    "email_verification",
    "dashboard",
    "profile",
    "addresses",
    "orders",
    "order_detail",
    "wishlist",
    "notification_preferences"
  ],
  "languages": ["de", "tr", "en", "ar"],
