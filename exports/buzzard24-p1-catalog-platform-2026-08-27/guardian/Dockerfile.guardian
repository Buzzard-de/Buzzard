FROM python:3.13-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi uvicorn pydantic
COPY buzzard_ai_guardian_max.py ./buzzard_ai_guardian_max.py
COPY buzzard_guardian_api.py ./buzzard_guardian_api.py
ENV BUZZARD_GUARDIAN_DB=/tmp/buzzard_guardian.sqlite3
ENV BUZZARD_BACKUP_DIR=/tmp/guardian_backups
ENV BUZZARD_SALES_ENABLED=0
EXPOSE 8001
CMD ["uvicorn", "buzzard_guardian_api:app", "--host", "0.0.0.0", "--port", "8001"]
