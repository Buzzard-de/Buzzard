{
  "name": "Buzzard Intelligence Pipeline",
  "version": "1.0",
  "domains": {
    "kfz_automotive": {
      "label": "KFZ / Automotive",
      "public_sources": [
        {
          "id": "kfz_intelligence_os",
          "type": "taxonomy_seed",
          "path": "data/taxonomy/buzzard_master_kfz_intelligence_os.json"
        },
        {
          "id": "intelligence_os_all_in_one",
          "type": "intelligence_os",
          "path": "data/taxonomy/buzzard_intelligence_os_all_in_one.json"
        },
        {
          "id": "intelligence_os_maximum_manifest",
          "type": "maximum_manifest",
          "path": "data/taxonomy/buzzard_intelligence_os_maximum_manifest.json"
        },
        {
          "id": "master_business_os_maximum_manifest",
          "type": "business_os_manifest",
          "path": "data/taxonomy/buzzard_master_business_os_maximum_manifest.json"
        },
        {
          "id": "master_business_os_maximum_single_file_html",
          "type": "business_os_console",
          "path": "data/taxonomy/buzzard_master_business_os_maximum_single_file.html"
        },
        {
          "id": "master_business_os_final_100_single_file_html",
          "type": "business_os_final_console",
          "path": "data/taxonomy/buzzard_master_business_os_final_100_single_file.html"
        },
        {
          "id": "kfz_shop_bridge",
          "type": "shop_bridge",
          "path": "data/taxonomy/kfz_shop_bridge.json"
        }
      ],
      "competitor_sources": [
        {"id": "autodoc", "name": "AUTODOC", "seed_url": "https://www.autodoc.de/"},
        {"id": "kfzteile24", "name": "kfzteile24", "seed_url": "https://www.kfzteile24.de/"},
        {"id": "atu", "name": "ATU", "seed_url": "https://www.atu.de/"},
        {"id": "atp", "name": "ATP Autoteile", "seed_url": "https://www.atp-autoteile.de/"},
        {"id": "bandel", "name": "Bandel Online", "seed_url": "https://www.bandel-online.de/"},
        {"id": "motointegrator", "name": "Motointegrator", "seed_url": "https://www.motointegrator.de/"},
        {"id": "pkwteile", "name": "pkwteile.de", "seed_url": "https://www.pkwteile.de/"},
        {"id": "daparto", "name": "Daparto", "seed_url": "https://www.daparto.de/"}
      ],
      "taxonomy_sink": {
        "kfz_intelligence_os": "data/taxonomy/buzzard_master_kfz_intelligence_os.json",
        "intelligence_os_all_in_one": "data/taxonomy/buzzard_intelligence_os_all_in_one.json",
        "intelligence_os_maximum_manifest": "data/taxonomy/buzzard_intelligence_os_maximum_manifest.json",
        "master_business_os_maximum_manifest": "data/taxonomy/buzzard_master_business_os_maximum_manifest.json",
        "master_business_os_maximum_single_file_html": "data/taxonomy/buzzard_master_business_os_maximum_single_file.html",
        "master_business_os_final_100_single_file_html": "data/taxonomy/buzzard_master_business_os_final_100_single_file.html",
        "intelligence_os_maximum_single_file_html": "data/taxonomy/buzzard_intelligence_os_maximum_single_file.html",
        "shop_bridge": "data/taxonomy/kfz_shop_bridge.json",
        "shop_root": "cat-05"
      }
    },
    "non_kfz_47": {
      "label": "47 Non-Kfz Categories",
      "public_sources": [
        {
          "id": "category_intelligence_47_manifest",
          "type": "category_intelligence_os",
          "path": "data/taxonomy/buzzard_47_category_intelligence_os.json"
        },
        {
          "id": "category_intelligence_47_console",
          "type": "category_intelligence_console",
          "path": "data/taxonomy/buzzard_47_category_intelligence_os.html"
        },
        {
          "id": "category_intelligence_47_final_100_single_file_html",
          "type": "category_intelligence_final_console",
          "path": "data/taxonomy/buzzard_47_category_intelligence_os_final_100_single_file.html"
        },
        {
          "id": "category_intelligence_47_max_final_single_file_html",
          "type": "category_intelligence_max_final_console",
          "path": "data/taxonomy/buzzard_47_category_intelligence_os_max_final_single_file.html"
        }
      ],
      "competitor_sources": [],
      "taxonomy_sink": {
        "manifest": "data/taxonomy/buzzard_47_category_intelligence_os.json",
        "console_html": "/taxonomy/buzzard_47_category_intelligence_os.html",
        "final_console_html": "/taxonomy/buzzard_47_category_intelligence_os_final_100_single_file.html",
        "max_final_console_html": "/taxonomy/buzzard_47_category_intelligence_os_max_final_single_file.html",
        "sync_command": "complete-sync-category-intelligence-47"
      }
    }
  },
  "rules": {
    "public_sources_only": true,
    "human_approval_required_for_taxonomy_write": true,
    "automatic_taxonomy_publish": false,
    "sales_enabled": false
  },
  "kurmay_agent": "aslan_bey"
}
