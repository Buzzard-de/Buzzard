{
  "name": "buzzard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "npm --prefix server run dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "node scripts/sync-redirects.mjs && next build && node scripts/post-export.mjs",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "postinstall": "npm --prefix server install",
    "security:audit": "npm audit --audit-level=high",
    "security:check": "node scripts/security-check.mjs",
    "verify:go-live": "node scripts/verify-go-live.mjs",
    "verify:local": "BUZZARD_SITE_URL=http://localhost:3000 BUZZARD_API_URL=http://localhost:3001 node scripts/verify-go-live.mjs",
    "test:smoke": "node scripts/smoke-core.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "search:sync": "node scripts/sync-search-index.mjs",
    "sync:taxonomy": "cd intelligence && python3 main.py complete-run-taxonomy-auto-sync",
    "sync:taxonomy:dry": "cd intelligence && python3 main.py complete-run-taxonomy-auto-sync --dry-run",
    "backup:ki": "cd intelligence && python3 main.py complete-build-ki-gesamt-backup --full-snapshot",
    "backup:ki:quick": "cd intelligence && python3 main.py complete-build-ki-gesamt-backup --skip-snapshot",
    "render:preflight": "node scripts/render-preflight.mjs",
    "wait:api": "node scripts/wait-for-api-health.mjs http://localhost:3001",
    "buzzard": "python Buzzard/app.py all",
    "buzzard:api": "python Buzzard/app.py api",
    "buzzard:voice": "python Buzzard/voice.py",
    "buzzard:8787": "python Buzzard/voice.py",
    "buzzard:ai": "python Buzzard/buzzard_ai.py",
    "gizli": "python Buzzard/app.py all",
    "gizli:api": "python Buzzard/app.py api",
    "gizli:voice": "python Buzzard/voice.py",
    "gizli:8787": "python Buzzard/voice.py",
    "gizli:start": "python Buzzard/app.py all"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.23",
    "typescript": "^5.7.0"
  }
}
